#!/bin/sh
# Refuse any push that is not built on the public history.
#
# This development repository keeps a private history (on `main`) next to the
# public one-commit history (on `publish`, pushed to GitHub as `main`). See
# docs/decisions/0004-publish-with-fresh-history.md. Install once per clone, into
# .git/hooks so it also runs while `publish` (which lacks this file) is checked out:
#     cp scripts/git-hooks/pre-push .git/hooks/pre-push

PUBLIC_ROOT=535dbae5aa5a30cfd519e7da7f86079ac1644a6c
ZERO=0000000000000000000000000000000000000000
status=0

refuse() {
    echo "pre-push: refused $1" >&2
    status=1
}

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$ZERO" ]; then
        refuse "deleting $remote_ref; delete remote branches on GitHub by hand if you mean it."
        continue
    fi
    if ! git merge-base --is-ancestor "$PUBLIC_ROOT" "$local_sha" 2>/dev/null; then
        refuse "$local_ref -> $remote_ref: it is not built on the public history (root ${PUBLIC_ROOT%${PUBLIC_ROOT#???????}}). The private main must never be pushed; cherry-pick onto 'publish' and push that."
        continue
    fi
    if [ "$remote_sha" = "$ZERO" ]; then
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    for email in $(git log --format='%ae %ce' $range); do
        case "$email" in
            *@users.noreply.github.com) ;;
            *) refuse "$local_ref -> $remote_ref: a commit carries the non-public email <$email>. Recommit it with the GitHub no-reply address."; break ;;
        esac
    done
done

if [ "$status" -ne 0 ]; then
    echo "pre-push: nothing was pushed. Bypassing this hook (--no-verify) defeats ADR 0004; do not." >&2
fi
exit "$status"
