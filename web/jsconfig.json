{
  "compilerOptions": {
    "allowJs": true, "checkJs": true, "module": "ESNext", "moduleResolution": "bundler",
    "target": "ES2022", "resolveJsonModule": true, "skipLibCheck": true,
    "types": ["svelte", "vite/client"]
  },
  "include": ["src/**/*.js", "src/**/*.svelte"],
  "exclude": ["node_modules", "dist", "test-results", "playwright-report"]
}
