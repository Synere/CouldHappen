{
  "groundwork": 1,
  "project": "CouldHappen",
  "preset": "large",
  "layers": [
    "core",
    "decisions",
    "open-work",
    "plans",
    "session-hook"
  ],
  "core": {
    "brief": "docs/designs/couldhappen.md",
    "markdown": [
      "AGENTS.md",
      "CLAUDE.md",
      "docs/**"
    ],
    "links": "relative",
    "agents": {
      "knowledge": "Everyone",
      "rules": "Everyone"
    }
  },
  "decisions": {
    "form": "files",
    "dir": "docs/decisions",
    "id": "ADR-n",
    "adopted": [],
    "citeIgnore": [
      "docs/templates/adr/**",
      "docs/decisions/.markdownlint.yml"
    ]
  },
  "grandfather": {
    "date": "2026-11-11",
    "decisionsThrough": 4
  },
  "checks": {
    "drop": {}
  },
  "openWork": {
    "register": "docs/issues.md",
    "id": "ISS-n",
    "features": [
      "focus"
    ],
    "focus": {
      "nudge": "off",
      "groups": true,
      "readers": "summary"
    }
  },
  "plans": {
    "dir": "docs/plans",
    "decId": "DEC-n"
  },
  "sessionHook": {
    "maxLines": 12,
    "harnesses": [
      "claude",
      "codex"
    ]
  }
}
