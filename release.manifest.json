{
  "schema_version": 1,
  "name": "couldhappen",
  "version": "0.1.11",
  "contract_version": 1,
  "include": [
    ".agents/skills/couldhappen/**",
    ".claude/skills/couldhappen/SKILL.md",
    "helpers/**",
    "web/**",
    "tests/**",
    "integrations/**",
    "public/story.md",
    "public/director.md",
    "public/cast.json",
    "public/work.json",
    "imports/README.md",
    "START_HERE.md",
    "couldhappen.json",
    ".gitignore",
    ".gitattributes",
    "README.md",
    "DESIGN.md",
    "LICENSE",
    "docs/README.md",
    "docs/setup.md",
    "docs/public-contract.md",
    "docs/reference-hosts.md"
  ],
  "exclude": [
    "web/node_modules/**",
    "web/dist/**",
    "web/test-results/**",
    "web/playwright-report/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "tests/test_release.py",
    "public/assets/**",
    ".impeccable/**",
    "docs/history/**",
    "docs/research/**",
    "docs/reviews/**",
    "docs/decisions/**",
    "docs/designs/**",
    "docs/implementation-progress.md",
    "docs/validation.md",
    "docs/validation-results.md",
    "PRODUCT.md",
    ".research/**",
    "goldfish_reviews/**",
    "release/**",
    "scripts/**",
    "release.manifest.json",
    ".codex/**",
    ".claude/*.json",
    ".claude/agents/**",
    ".claude/commands/**",
    ".claude/hooks/**",
    ".claude/skills/impeccable/**",
    ".pi/**",
    ".gemini/**",
    ".env",
    ".env.*"
  ],
  "templates": {
    "couldhappen.json": "release/couldhappen.json",
    "public/story.md": "release/public/story.md",
    "public/director.md": "release/public/director.md",
    "public/cast.json": "release/public/cast.json",
    "public/work.json": "release/public/work.json",
    ".gitignore": "release/.gitignore"
  },
  "required": [
    ".agents/skills/couldhappen/SKILL.md",
    ".claude/skills/couldhappen/SKILL.md",
    "helpers/__init__.py",
    "helpers/__main__.py",
    "web/package.json",
    "web/package-lock.json",
    "web/index.html",
    "web/src/App.svelte",
    "web/fonts/source-serif-4-LICENSE",
    "web/fonts/source-sans-3-LICENSE",
    "tests/test_files.py",
    "integrations/codex/hooks.example.json",
    "public/story.md",
    "public/director.md",
    "public/cast.json",
    "public/work.json",
    "imports/README.md",
    "START_HERE.md",
    "couldhappen.json",
    ".gitignore",
    ".gitattributes",
    "README.md",
    "DESIGN.md",
    "LICENSE",
    "docs/README.md",
    "docs/setup.md",
    "docs/public-contract.md",
    "web/README.md",
    "docs/reference-hosts.md"
  ],
  "forbidden": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "CLAUDE.md",
    ".git/**",
    ".impeccable/**",
    "docs/history/**",
    "docs/research/**",
    "docs/reviews/**",
    "docs/decisions/**",
    "docs/designs/**",
    "docs/implementation-progress.md",
    "docs/validation.md",
    "docs/validation-results.md",
    "PRODUCT.md",
    ".research/**",
    "goldfish_reviews/**",
    "release/**",
    "scripts/**",
    "release.manifest.json",
    ".codex/**",
    ".claude/*.json",
    ".claude/agents/**",
    ".claude/commands/**",
    ".claude/hooks/**",
    ".claude/skills/impeccable/**",
    ".pi/**",
    ".gemini/**",
    "web/node_modules/**",
    "web/dist/**",
    "web/test-results/**",
    "web/playwright-report/**",
    "tests/test_release.py",
    "public/assets/**",
    ".env",
    ".env.*"
  ],
  "content_patterns": [
    "BEGIN OPENSSH PRIVATE KEY",
    "BEGIN RSA PRIVATE KEY",
    "BEGIN EC PRIVATE KEY",
    "OPENROUTER_API_KEY=",
    "GITHUB_TOKEN=",
    "sk-or-v1-",
    "PRIVATE_BOUNDARY_FIXTURE"
  ],
  "content_pattern_allow_paths": [
    "tests/",
    "web/tests/"
  ]
}
